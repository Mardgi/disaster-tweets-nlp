s:\", len(X_train))\nprint(\"Validation samples:\", len(X_val))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T09:12:14.279024Z","iopub.execute_input":"2026-10-21T09:12:14.279477Z","iopub.status.idle":"2026-10-21T09:12:14.322334Z","shell.execute_reply.started":"2026-10-21T09:12:14.279449Z","shell.execute_reply":"2026-10-21T09:12:14.321503Z"}},"outputs":[{"name":"stdout","text":"Training samples: 6090\nValidation samples: 1523\n","output_type":"stream"}],"execution_count":13},{"cell_type":"code","source":"from sklearn.dummy import DummyClassifier\nfrom sklearn.metrics import accuracy_score, classification_report\n\n# Initialize the baseline classifier\ndummy_clf = DummyClassifier(strategy=\"most_frequent\")\n\n# Train the classifier\ndummy_clf.fit(X_train, y_train)\n\n# Predict the validation set\ny_pred_dummy = dummy_clf.predict(X_val)\n\n# Evaluate the predictions\nprint(\"Accuracy:\", accuracy_score(y_val, y_pred_dummy))\nprint(classification_report(y_val, y_pred_dummy))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T09:12:21.268549Z","iopub.execute_input":"2026-10-21T09:12:21.268923Z","iopub.status.idle":"2026-10-21T09:12:21.295317Z","shell.execute_reply.started":"2026-10-21T09:12:21.26889Z","shell.execute_reply":"2026-10-21T09:12:21.29434Z"}},"outputs":[{"name":"stdout","text":"Accuracy: 0.5705843729481287\n              precision    recall  f1-score   support\n\n           0       0.57      1.00      0.73       869\n           1       0.00      0.00      0.00       654\n\n    accuracy                           0.57      1523\n   macro avg       0.29      0.50      0.36      1523\nweighted avg       0.33      0.57      0.41      1523\n\n","output_type":"stream"},{"name":"stderr","text":"/usr/local/lib/python3.13/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: Precision is ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n/usr/local/lib/python3.13/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: Precision is ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n/usr/local/lib/python3.13/dist-packages/sklearn/metrics/_classification.py:1565: UndefinedMetricWarning: Precision is ill-defined and being set to 0.0 in labels with no predicted samples. Use `zero_division` parameter to control this behavior.\n  _warn_prf(average, modifier, f\"{metric.capitalize()} is\", len(result))\n","output_type":"stream"}],"execution_count":14},{"cell_type":"markdown","source":"***Observations***\n\nThe DummyClassifier achieves an accuracy of approximately 57.06%.\n\nHowever, this result is obtained by always predicting the majority\nclass (target = 0), regardless of the tweet content.\n\nConsequently, the classifier achieves a recall of 1.00 for class 0\nbut fails to identify any disaster-related tweets (class 1).\n\nThis baseline illustrates why accuracy alone is insufficient to\nevaluate a classifier. Precision, recall and F1-score are also\nimportant, particularly for assessing the identification of disaster\ntweets.\n\nMore sophisticated models should be compared against this baseline\nto determine whether they learn useful patterns from the text.","metadata":{}},{"cell_type":"markdown","source":"\n## 5. TF-IDF + Logistic Regression\n\nWe use TF-IDF to represent tweets as numerical features and\nLogistic Regression to classify them as disaster-related or not.\n\nTF-IDF converts text into numerical features that represent the\nimportance of words in each tweet relative to the entire corpus.\nWords that are frequent in a tweet but less common across the\ncorpus tend to receive higher weights.\n\n**Logistic Regression**\n\nLogistic Regression is a supervised learning algorithm used for\nclassification. It learns a relationship between the numerical\nfeatures and the target labels, estimating the probability that\na tweet belongs to each class.\n\n**Model pipeline**\n\nThe two components are combined in a pipeline:\n1. TF-IDF transforms the tweets into numerical feature vectors.\n2. Logistic Regression uses these features to classify tweets\n   as disaster-related (`target = 1`) or not (`target = 0`).\n\nThe model is trained on the training set and evaluated on a\nseparate validation set.","metadata":{}},{"cell_type":"code","source":"from sklearn.pipeline import Pipeline\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.linear_model import LogisticRegression\n\n# Define the pipeline\ntext_clf = Pipeline([\n    (\"tfidf\", TfidfVectorizer()),\n    (\"classifier\", LogisticRegression(max_iter=1000))\n])\n\n# Train the model\ntext_clf.fit(X_train, y_train)\n\n# Predict the validation set\ny_pred = text_clf.predict(X_val)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T09:23:57.518899Z","iopub.execute_input":"2026-10-21T09:23:57.519334Z","iopub.status.idle":"2026-10-21T09:23:59.020779Z","shell.execute_reply.started":"2026-10-21T09:23:57.5193Z","shell.execute_reply":"2026-10-21T09:23:59.019437Z"}},"outputs":[],"execution_count":15},{"cell_type":"code","source":"from sklearn.metrics import accuracy_score, classification_report\n\nprint(\"Accuracy:\", accuracy_score(y_val, y_pred))\nprint(classification_report(y_val, y_pred))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T09:24:57.115487Z","iopub.execute_input":"2026-10-21T09:24:57.116097Z","iopub.status.idle":"2026-10-21T09:24:57.135752Z","shell.execute_reply.started":"2026-10-21T09:24:57.11606Z","shell.execute_reply":"2026-10-21T09:24:57.134632Z"}},"outputs":[{"name":"stdout","text":"Accuracy: 0.8069599474720945\n              precision    recall  f1-score   support\n\n           0       0.81      0.87      0.84       869\n           1       0.80      0.73      0.76       654\n\n    accuracy                           0.81      1523\n   macro avg       0.81      0.80      0.80      1523\nweighted avg       0.81      0.81      0.81      1523\n\n","output_type":"stream"}],"execution_count":16},{"cell_type":"markdown","source":"***Observations***\n\nCompared with the DummyClassifier baseline, the model shows a\nsubstantial improvement in classification performance.\n\nUnlike the baseline, which always predicts the majority class,\nthe text classifier identifies disaster-related tweets by learning\npatterns from the training data.\n\nThe results suggest that TF-IDF features combined with Logistic\nRegression provide a useful starting point for this text\nclassification task.\n\nFurther experiments will investigate whether alternative\npreprocessing strategies and model configurations can improve\nperformance.","metadata":{}},{"cell_type":"markdown","source":"### Confusion Matrix\n\nThe confusion matrix provides a detailed view of the classification\nresults by comparing the true labels with the predicted labels.\n\nIt allows us to identify correct predictions and the two types\nof classification errors:\n- False positives: non-disaster tweets classified as disasters.\n- False negatives: disaster tweets classified as non-disasters.","metadata":{}},{"cell_type":"code","source":"import matplotlib.pyplot as plt\nfrom sklearn.metrics import ConfusionMatrixDisplay, confusion_matrix\n\ncm = confusion_matrix(y_val, y_pred)\n\ndisp = ConfusionMatrixDisplay(\n    confusion_matrix=cm,\n    display_labels=[\"Not Disaster\", \"Disaster\"]\n)\n\ndisp.plot()\nplt.title(\"Confusion Matrix - TF-IDF + Logistic Regression\")\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-21T09:48:45.30914Z","iopub.execute_input":"2026-10-21T09:48:45.309672Z","iopub.status.idle":"2026-10-21T09:48:45.592313Z","shell.execute_reply.started":"2026-1